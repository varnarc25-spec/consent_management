# GCP Cloud Build substitutions — copy to cloudbuild.substitutions.yaml or pass via trigger UI.
#
# Usage:
#   gcloud builds submit --config=cloudbuild.yaml \
#     --substitutions=_REGION=us-central1,_NEXT_PUBLIC_API_URL=https://api.example.com/api/v1,...

_REGION: us-central1
_REPOSITORY: cmp

_API_SERVICE: cmp-api
_ADMIN_SERVICE: cmp-admin
_WEB_SERVICE: cmp-web

# Cloud SQL instance connection name: PROJECT_ID:REGION:INSTANCE
_CLOUDSQL_INSTANCE: your-project-id:us-central1:cmp-db

# Production URLs (no trailing slash)
_API_URL: https://api.example.com
_ADMIN_URL: https://admin.example.com
_WEB_URL: https://www.example.com

# Baked into admin image at build time
_NEXT_PUBLIC_API_URL: https://api.example.com/api/v1
_AUTH0_DOMAIN: your-tenant.us.auth0.com

# Comma-separated secret names in Secret Manager (must exist before deploy)
_API_SECRETS: DATABASE_URL=DATABASE_URL:latest,JWT_ACCESS_SECRET=JWT_ACCESS_SECRET:latest,JWT_REFRESH_SECRET=JWT_REFRESH_SECRET:latest
_ADMIN_SECRETS: AUTH0_CLIENT_SECRET=AUTH0_CLIENT_SECRET:latest,AUTH0_SECRET=AUTH0_SECRET:latest

# Auth0 client ID (non-secret, passed as env var)
_AUTH0_CLIENT_ID: your-auth0-client-id
