# syntax=docker/dockerfile:1

FROM node:20-alpine AS base
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@9.6.0 --activate
WORKDIR /app

FROM base AS pruner
COPY . .
RUN pnpm dlx turbo@2.10.7 prune @cmp/api --docker

FROM base AS deps
COPY --from=pruner /app/out/json/ .
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN pnpm install --frozen-lockfile

FROM base AS builder
COPY --from=pruner /app/out/full/ .
COPY --from=pruner /app/tsconfig.base.json ./tsconfig.base.json
COPY --from=deps /app/node_modules ./node_modules
COPY --from=pruner /app/out/pnpm-lock.yaml ./pnpm-lock.yaml
RUN apk add --no-cache openssl libc6-compat ca-certificates
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @cmp/database generate
RUN pnpm --filter @cmp/sdk build
RUN pnpm --filter @cmp/api... build
RUN pnpm --filter @cmp/api deploy --prod /prod/api
RUN SCHEMA="$(find /prod/api/node_modules -path '*/@cmp/database/prisma/schema.prisma' -print -quit)" && \
    test -n "$SCHEMA" && \
    pnpm exec prisma generate --schema="$SCHEMA"

FROM node:20-bookworm-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright

RUN apt-get update && apt-get install -y --no-install-recommends \
    openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN addgroup --system --gid 1001 nodejs && \
    adduser --system --uid 1001 nestjs

COPY --from=builder --chown=nestjs:nodejs /prod/api ./
COPY --chown=nestjs:nodejs deploy/migrate.sh ./deploy/migrate.sh
COPY --chown=nestjs:nodejs deploy/start-api.sh ./start-api.sh
RUN chmod +x ./deploy/migrate.sh ./start-api.sh

# Regenerate Prisma for Debian (builder uses Alpine musl binaries).
# Install Playwright Chromium + OS libs for website scans.
RUN SCHEMA="$(find /app/node_modules -path '*/@cmp/database/prisma/schema.prisma' -print -quit)" && \
    test -n "$SCHEMA" && \
    npx prisma generate --schema="$SCHEMA" && \
    npx playwright install-deps chromium && \
    npx playwright install chromium && \
    chown -R nestjs:nodejs /app/node_modules/.prisma /ms-playwright

USER nestjs
EXPOSE 8080
CMD ["./start-api.sh"]
